<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Yukari.Views.Dialogs.LibraryImportDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:converters="using:Yukari.Helpers.UI.Converters"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:enums="using:Yukari.Enums"
               xmlns:helpers="using:Yukari.Helpers.UI"
               xmlns:local="using:Yukari.Views.Dialogs"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:ui="using:CommunityToolkit.WinUI"
               x:Uid="LibraryImportDialog"
               CloseButtonCommand="{x:Bind ViewModel.CancelImportCommand}"
               CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.IsImportAvailable, Mode=OneWay}"
               PrimaryButtonClick="LibraryImportDialog_PrimaryButtonClick"
               Style="{StaticResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Title>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon FontSize="24" Glyph="&#xE8B5;" />
            <TextBlock x:Uid="LibraryImportHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ContentDialog.Resources>

    <Grid Width="320">
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsFormVisible, Mode=OneWay}">
            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="2">
                <TextBox x:Uid="ImportArchivePathTXBox"
                         Grid.Column="0"
                         Text="{x:Bind ViewModel.ArchivePath, Mode=TwoWay}"
                         ToolTipService.ToolTip="{x:Bind ViewModel.ArchivePath, Mode=OneWay}" />
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.OpenArchiveFilePickerCommand}"
                        Content="{ui:FontIcon Glyph=&#xF89A;}" />
            </Grid>

            <ComboBox x:Uid="LibraryImportModeCBBox"
                      HorizontalAlignment="Stretch"
                      ItemsSource="{x:Bind ViewModel.AvailableImportModes}"
                      SelectedItem="{x:Bind ViewModel.SelectedImportMode, Mode=TwoWay}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="enums:LibraryImportMode">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon VerticalAlignment="Center" FontSize="14" Glyph="{x:Bind helpers:LibraryImportModeHelper.ToGlyph((enums:LibraryImportMode))}" />
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind helpers:LibraryImportModeHelper.ToDisplayName((enums:LibraryImportMode))}" />
                        </StackPanel>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <MenuFlyoutSeparator Margin="0,2,0,0" />
            <InfoBar x:Uid="LibraryImportMergeInfoBar"
                     IsClosable="False"
                     IsOpen="True"
                     Severity="Informational"
                     Visibility="{x:Bind ViewModel.IsMergeMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
            <InfoBar x:Uid="LibraryImportReplaceInfoBar"
                     IsClosable="False"
                     IsOpen="True"
                     Severity="Warning"
                     Visibility="{x:Bind ViewModel.IsReplaceMode, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
        </StackPanel>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowDefinitions="Auto, Auto, Auto"
              RowSpacing="8"
              Visibility="{x:Bind ViewModel.IsImporting, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <ProgressBar Width="240"
                         IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                         Maximum="{x:Bind ViewModel.ImportTotal, Mode=OneWay}"
                         Value="{x:Bind ViewModel.ImportProgress, Mode=OneWay}" />
            <TextBlock Grid.Row="1" HorizontalAlignment="Center" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
        </Grid>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowDefinitions="Auto, Auto, Auto"
              RowSpacing="8"
              Visibility="{x:Bind ViewModel.IsImported, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <FontIcon FontSize="48" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xEC61;" />
            <TextBlock x:Uid="ImportSuccessTXB"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
            <InfoBar x:Uid="LibraryImportPendingRestartInfoBar"
                     Grid.Row="2"
                     IsClosable="False"
                     IsOpen="True"
                     Severity="Warning"
                     Visibility="{x:Bind ViewModel.IsPendingRestart, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}" />
        </Grid>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowDefinitions="Auto, Auto, Auto"
              RowSpacing="8"
              Visibility="{x:Bind ViewModel.IsError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <FontIcon FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xEB90;" />
            <TextBlock x:Uid="ImportErrorTXB"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
            <ScrollViewer Grid.Row="2"
                          MaxWidth="320"
                          MaxHeight="200"
                          Padding="8"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock FontFamily="Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextSelectionEnabled="True"
                           Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
