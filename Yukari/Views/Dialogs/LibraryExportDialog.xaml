<?xml version="1.0" encoding="utf-8" ?>
<ContentDialog x:Class="Yukari.Views.Dialogs.LibraryExportDialog"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:converters="using:Yukari.Helpers.UI.Converters"
               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
               xmlns:local="using:Yukari.Views.Dialogs"
               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
               xmlns:ui="using:CommunityToolkit.WinUI"
               x:Uid="LibraryExportDialog"
               CloseButtonCommand="{x:Bind ViewModel.CancelExportCommand}"
               CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
               DefaultButton="Primary"
               IsPrimaryButtonEnabled="{x:Bind ViewModel.IsExportAvailable, Mode=OneWay}"
               PrimaryButtonClick="LibraryExportDialog_PrimaryButtonClick"
               Style="{StaticResource DefaultContentDialogStyle}"
               mc:Ignorable="d">

    <ContentDialog.Title>
        <StackPanel Orientation="Horizontal" Spacing="12">
            <FontIcon FontSize="24" Glyph="&#xEDE1;" />
            <TextBlock x:Uid="LibraryExportHeader" Style="{StaticResource SubtitleTextBlockStyle}" />
        </StackPanel>
    </ContentDialog.Title>

    <ContentDialog.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </ContentDialog.Resources>

    <Grid Width="320">
        <StackPanel Spacing="4" Visibility="{x:Bind ViewModel.IsFormVisible, Mode=OneWay}">
            <TextBox x:Uid="ExportNameTXBox" Text="{x:Bind ViewModel.ExportName, Mode=TwoWay}" ToolTipService.ToolTip="{x:Bind ViewModel.ExportName, Mode=OneWay}" />

            <Grid ColumnDefinitions="*, Auto" ColumnSpacing="2">
                <TextBox x:Uid="ExportDestinationTXBox"
                         Grid.Column="0"
                         Text="{x:Bind ViewModel.DestinationPath, Mode=TwoWay}"
                         ToolTipService.ToolTip="{x:Bind ViewModel.DestinationPath, Mode=OneWay}" />
                <Button Grid.Column="1"
                        Width="32"
                        Height="32"
                        Padding="0"
                        VerticalAlignment="Bottom"
                        Command="{x:Bind ViewModel.OpenDestinationPathPickerCommand}"
                        Content="{ui:FontIcon Glyph=&#xF89A;}" />
            </Grid>

            <CheckBox x:Uid="IncludeDownloadsCHK" IsChecked="{x:Bind ViewModel.IncludeDownloads, Mode=TwoWay}" />
            <CheckBox x:Uid="IncludePluginsCHK" IsChecked="{x:Bind ViewModel.IncludePlugins, Mode=TwoWay}" />

            <MenuFlyoutSeparator Margin="0,2,0,0" />
            <InfoBar x:Uid="LibraryExportLocalComicsInfoBar"
                     IsClosable="False"
                     IsOpen="True"
                     Severity="Warning" />
        </StackPanel>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowDefinitions="Auto, Auto, Auto"
              RowSpacing="8"
              Visibility="{x:Bind ViewModel.IsExporting, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <ProgressBar Width="240"
                         IsIndeterminate="{x:Bind ViewModel.IsProgressIndeterminate, Mode=OneWay}"
                         Maximum="{x:Bind ViewModel.ExportTotal, Mode=OneWay}"
                         Value="{x:Bind ViewModel.ExportProgress, Mode=OneWay}" />
            <TextBlock Grid.Row="1" HorizontalAlignment="Center" Text="{x:Bind ViewModel.ProgressText, Mode=OneWay}" />
        </Grid>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowDefinitions="Auto, Auto, Auto"
              RowSpacing="8"
              Visibility="{x:Bind ViewModel.IsExported, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <FontIcon FontSize="48" Foreground="{ThemeResource SystemFillColorSuccessBrush}" Glyph="&#xEC61;" />
            <TextBlock x:Uid="ExportSuccessTXB"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
        </Grid>

        <Grid HorizontalAlignment="Center"
              VerticalAlignment="Center"
              RowDefinitions="Auto, Auto, Auto"
              RowSpacing="8"
              Visibility="{x:Bind ViewModel.IsError, Converter={StaticResource BooleanToVisibilityConverter}, Mode=OneWay}">
            <FontIcon FontSize="48" Foreground="{ThemeResource SystemFillColorCriticalBrush}" Glyph="&#xEB90;" />
            <TextBlock x:Uid="ExportErrorTXB"
                       Grid.Row="1"
                       HorizontalAlignment="Center"
                       Style="{StaticResource BodyLargeStrongTextBlockStyle}" />
            <ScrollViewer Grid.Row="2"
                          MaxWidth="320"
                          MaxHeight="200"
                          Padding="8"
                          Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                          BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                          BorderThickness="1"
                          CornerRadius="8"
                          HorizontalScrollBarVisibility="Disabled"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock FontFamily="Consolas"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                           IsTextSelectionEnabled="True"
                           Text="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                           TextWrapping="Wrap" />
            </ScrollViewer>
        </Grid>
    </Grid>
</ContentDialog>
